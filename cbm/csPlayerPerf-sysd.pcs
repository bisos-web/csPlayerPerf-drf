#!/usr/bin/env python

""" #+begin_org
* Overview
csPlayerPerf-sysd.pcs: the csPlayerPerf systemd unit --- gunicorn serving server/ (the csPlayerPerf
Django project) as csplayer, on 127.0.0.1 only. Declared by csPlayerPerf-cbs.pcs.

One worker, with threads: the server tracks running operations in memory (api/OperationHandling.py,
a timer thread per process), so a second worker would not see the first one's operations.
#+end_org """

from bisos.debian import systemd_seedInfo
from bisos.debian import systemd_seed as systemd_seed  # noqa

import pathlib
import sys

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent))
import csPlayerPerfInfo as info  # noqa: E402


def sysdUnitFileFunc() -> str | None:
    """Produce the unit file as a string."""
    if not info.gunicorn.exists():
        return None

    templateStr = f"""
[Unit]
Description=csPlayerPerf --- csPlayer's performer (Django REST API, gunicorn)
After=network.target

[Service]
Type=simple
User={info.acctName}
Group={info.acctName}
EnvironmentFile={info.envFile}
WorkingDirectory={info.serverDir}
ExecStart={info.gunicorn} csPlayerPerf.wsgi:application --bind {info.listenIp}:{info.portNu} --workers 1 --threads 8 --access-logfile -
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
"""
    return templateStr


systemd_seedInfo.setup(
    seedType="sysdSysUnit",
    sysdUnitName="csPlayerPerf",
    sysdUnitFileFunc=sysdUnitFileFunc,
)
